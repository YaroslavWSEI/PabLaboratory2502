Content-Type: application/json

{ "email": "jan.kowalski@crm.pl", "password": "Manager@123!" }

###

# ══════════════════════════════════════════
#  PERSONS  (api/contacts — unchanged)
# ══════════════════════════════════════════

### 🟢 GET all persons (paged)
GET {{WebApi_HostAddress}}/api/contacts?page=1&size=10
Authorization: Bearer {{token}}

### 🔎 GET person by ID
GET {{WebApi_HostAddress}}/api/contacts/{{personId}}
Authorization: Bearer {{token}}

### 🟢 CREATE person (valid PESEL)
POST {{WebApi_HostAddress}}/api/contacts
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "firstName": "Piotr",
  "lastName": "Zieliński",
  "email": "piotr@wsei.edu.pl",
  "phone": "555666777",
  "pesel": "44051401359",
  "gender": 0,
  "address": {
    "street": "Krakowska 10",
    "city": "Kraków",
    "postalCode": "31-001",
    "country": "PL",
    "type": 0
  }
}

### ❌ CREATE person (invalid PESEL — expects 400)
POST {{WebApi_HostAddress}}/api/contacts
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "firstName": "Błąd",
  "lastName": "Pesel",
  "email": "error@test.pl",
  "phone": "000000000",
  "pesel": "123",
  "gender": 0
}

### ✏️ UPDATE person
PUT {{WebApi_HostAddress}}/api/contacts/{{personId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "id": "{{personId}}",
  "firstName": "Adam",
  "lastName": "Nowak",
  "email": "adam@wsei.edu.pl",
  "phone": "123456789"
}

### 🔗 ASSIGN person to organization (via contacts controller)
PATCH {{WebApi_HostAddress}}/api/contacts/{{personId}}/assign-organization/{{orgId}}
Authorization: Bearer {{token}}

### 🔎 SEARCH persons by email domain
GET {{WebApi_HostAddress}}/api/contacts/search?emailDomain=wsei.edu.pl
Authorization: Bearer {{token}}

### 🔎 SEARCH persons by organization membership
GET {{WebApi_HostAddress}}/api/contacts/search?organizationId={{orgId}}
Authorization: Bearer {{token}}

### 📝 ADD note to person
POST {{WebApi_HostAddress}}/api/contacts/{{personId}}/notes
Content-Type: application/json
Authorization: Bearer {{token}}

{ "content": "Pierwsza notatka" }

### 📄 GET notes for person
GET {{WebApi_HostAddress}}/api/contacts/{{personId}}/notes
Authorization: Bearer {{token}}

### 🗑️ DELETE person
DELETE {{WebApi_HostAddress}}/api/contacts/{{personId}}
Authorization: Bearer {{token}}

### 🏢 GET all organizations (paged)
GET {{WebApi_HostAddress}}/api/organizations?page=1&size=10
Authorization: Bearer {{token}}

### 🔎 GET organization by ID (includes members)
GET {{WebApi_HostAddress}}/api/organizations/{{orgId}}
Authorization: Bearer {{token}}

### 👥 GET members of organization
GET {{WebApi_HostAddress}}/api/organizations/{{orgId}}/members
Authorization: Bearer {{token}}

### 🔎 SEARCH organizations by name
GET {{WebApi_HostAddress}}/api/organizations/search?name=WSEI
Authorization: Bearer {{token}}

### 🔎 SEARCH organizations by email domain
GET {{WebApi_HostAddress}}/api/organizations/search?emailDomain=wsei.edu.pl
Authorization: Bearer {{token}}

### 🟢 CREATE organization
POST {{WebApi_HostAddress}}/api/organizations
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "WSEI Uczelnia",
  "email": "kontakt@wsei.edu.pl",
  "phone": "123000000",
  "registrationNumber": "0000123456",
  "type": 0,
  "address": {
    "street": "Ul. Filipa 17",
    "city": "Kraków",
    "postalCode": "31-150",
    "country": "PL",
    "type": 1
  }
}

### ✏️ UPDATE organization
PUT {{WebApi_HostAddress}}/api/organizations/{{orgId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "id": "{{orgId}}",
  "name": "WSEI Updated",
  "email": "info@wsei.edu.pl",
  "phone": "123000001"
}

### 🔗 ADD person as member of organization
PATCH {{WebApi_HostAddress}}/api/organizations/{{orgId}}/members/{{personId}}
Authorization: Bearer {{token}}

### ❌ REMOVE person from organization
DELETE {{WebApi_HostAddress}}/api/organizations/{{orgId}}/members/{{personId}}
Authorization: Bearer {{token}}

### 🗑️ DELETE organization
DELETE {{WebApi_HostAddress}}/api/organizations/{{orgId}}
Authorization: Bearer {{token}}